diff --git a/kernel/src/object/capability/file/syscall.rs b/kernel/src/object/capability/file/syscall.rs
index 6b17e2651..57cb47884 100644
--- a/kernel/src/object/capability/file/syscall.rs
+++ b/kernel/src/object/capability/file/syscall.rs
@@ -7,6 +7,7 @@ use super::SeekFrom;
 use crate::arch::Trapframe;
 use crate::fs::AbiFileMetadata;
 use crate::library::std::usercopy::copy_to_user;
+use crate::object::KernelObject;
 use crate::task::mytask;
 
 fn stream_errno(error: crate::object::capability::StreamError) -> usize {
@@ -142,40 +143,41 @@ pub fn sys_file_truncate(trapframe: &mut Trapframe) -> usize {
 ///
 /// # Arguments
 ///
-/// - `handle`: Handle to the KernelObject (must support FileObject)
+/// - `handle`: Handle to a file or anonymous pipe KernelObject
 /// - `metadata_ptr`: Pointer to an `AbiFileMetadata` structure to fill
 ///
 /// # Returns
 ///
 /// - On success: `0`
-/// - On error: `usize::MAX`
+/// - On error: `usize::MAX`, including invalid handles and invalid output memory.
+///
+/// This is a legacy sentinel-result syscall. Do not return encoded errno values
+/// here: existing FileError::from_syscall_result callers would treat -EBADF (and
+/// other values besides -1) as success and consume an uninitialized record.
 pub fn sys_file_metadata(trapframe: &mut Trapframe) -> usize {
     let task = match mytask() {
         Some(task) => task,
         None => return usize::MAX,
     };
 
-    let handle = trapframe.get_arg(0) as u32;
+    let handle = trapframe.get_arg(0);
     let metadata_ptr = trapframe.get_arg(1);
 
     // Increment PC to avoid infinite loop if metadata fails
     trapframe.increment_pc_next(&task);
 
     // Get KernelObject from handle table
-    let kernel_obj = match task.handle_table.get(handle) {
+    let kernel_obj = match u32::try_from(handle)
+        .ok()
+        .and_then(|handle| task.handle_table.get(handle))
+    {
         Some(obj) => obj,
         None => return usize::MAX, // Invalid handle
     };
 
-    // Check if object supports FileObject operations
-    let file = match kernel_obj.as_file() {
-        Some(file) => file,
-        None => return usize::MAX, // Object doesn't support file operations
-    };
-
-    let metadata = match file.metadata() {
-        Ok(metadata) => AbiFileMetadata::from_metadata(&metadata),
-        Err(_) => return usize::MAX,
+    let metadata = match object_metadata(&kernel_obj) {
+        Some(metadata) => metadata,
+        None => return usize::MAX,
     };
 
     // SAFETY: `metadata` is a plain `repr(C)` byte record and is only read for
@@ -192,3 +194,36 @@ pub fn sys_file_metadata(trapframe: &mut Trapframe) -> usize {
         Err(_) => usize::MAX,
     }
 }
+
+/// Query object state without granting pipes seek/truncate capabilities or
+/// manufacturing a regular-file record for an unsupported object.
+fn object_metadata(object: &KernelObject) -> Option<AbiFileMetadata> {
+    if let Some(file) = object.as_file() {
+        return file
+            .metadata()
+            .ok()
+            .map(|metadata| AbiFileMetadata::from_metadata(&metadata));
+    }
+    let pipe = object.as_pipe()?;
+    // Real pipe endpoints share this identity across both ends and duplicates.
+    // An implementation without an identity cannot provide this record.
+    let file_id = pipe.pipe_id()?;
+    let mut permissions = 0;
+    if pipe.is_readable() {
+        permissions |= crate::fs::ABI_FILE_PERMISSION_READ;
+    }
+    if pipe.is_writable() {
+        permissions |= crate::fs::ABI_FILE_PERMISSION_WRITE;
+    }
+    Some(AbiFileMetadata {
+        file_type: crate::fs::ABI_FILE_TYPE_PIPE,
+        file_id,
+        permissions,
+        // This is a snapshot of queued bytes, not the pipe capacity or a
+        // seekable file length. Observing it does not consume data.
+        size: pipe.available_bytes() as u64,
+        // Anonymous pipes have no directory links or tracked timestamps.
+        // Keep those unavailable fields and the reserved word zero.
+        ..AbiFileMetadata::default()
+    })
+}
diff --git a/tests/native-pipe-metadata/README.md b/tests/native-pipe-metadata/README.md
new file mode 100644
index 000000000..346223c36
--- /dev/null
+++ b/tests/native-pipe-metadata/README.md
@@ -0,0 +1,35 @@
+# Native pipe metadata regression
+
+`main.c` is an AArch64 native C guest test linked to the shared Scarlet SDK C
+runtime. It calls both the real `fstat` adapter and raw `FileMetadata` syscall
+302. It checks FIFO type, stable identity across both ends and duplicates,
+different identities for different pipes, endpoint access permissions, queued
+byte snapshots without consuming data, metadata after peer closure, and the
+unchanged regular-file metadata path.
+
+Invalid/closed handles, a high-word alias of a valid handle, and an invalid
+output pointer must fail. Invalid-handle queries must not overwrite the supplied
+metadata record. The syscall retains its legacy `usize::MAX` failure sentinel:
+older `FileError::from_syscall_result` consumers recognize only that value.
+Returning `-EBADF` from syscall 302 would incorrectly look successful to them.
+The C adapter still rejects negative descriptors as `EBADF`; the test verifies
+that behavior separately. A future errno-preserving metadata API should use a
+separate status-aware syscall and migrate callers explicitly.
+
+Anonymous pipes expose their existing shared `pipe_id`, endpoint read/write
+capabilities, and the current queue length. They have no directory links or
+tracked timestamps, so those fields are zero. They do not gain file seek or
+truncate capability. Objects lacking file/pipe metadata remain unsupported.
+
+Compile using the same raw AArch64 C flags and SDK runtime as other native C
+fixtures, then run after the distribution init has established the Environment
+and writable `/tmp`. Success requires exit 0 and `NATIVE_PIPE_METADATA_OK`.
+The Git port's `compat/scarlet/http/guest-test.py` accepts
+`--pipe-metadata-source /absolute/path/to/this/main.c` to compile and execute
+this probe in the same guest before the HTTPS and Git checks.
+
+Validated on 2026-11-13 with toolchain `71dd0425890d` and a release AArch64
+kernel under TCG/OVMF. The probe exited 0 and printed its success marker; the
+same guest subsequently completed Git smart HTTPS shallow clone, matched the
+host HEAD/README, and passed `git fsck --full --strict`. Compact evidence is
+retained by the Git port in `compat/scarlet/http/target/git-https-tcg-02`.
diff --git a/tests/native-pipe-metadata/main.c b/tests/native-pipe-metadata/main.c
new file mode 100644
index 000000000..86eb39135
--- /dev/null
+++ b/tests/native-pipe-metadata/main.c
@@ -0,0 +1,94 @@
+/* Native FileMetadata(302) and the SDK's real C fstat adapter, AArch64. */
+#include <errno.h>
+#include <fcntl.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+struct raw_metadata {
+    uint64_t size;
+    uint32_t type, permissions;
+    uint64_t created, modified, accessed, id;
+    uint32_t links, reserved;
+};
+_Static_assert(sizeof(struct raw_metadata) == 56, "Native metadata layout");
+
+static uintptr_t metadata(uintptr_t handle, struct raw_metadata *out)
+{
+    register uintptr_t result __asm__("x0") = handle;
+    register uintptr_t pointer __asm__("x1") = (uintptr_t)out;
+    register uintptr_t number __asm__("x8") = 302;
+    __asm__ volatile("svc #0" : "+r"(result) : "r"(pointer), "r"(number) : "memory");
+    return result;
+}
+
+#define CHECK(condition) do { \
+    if (!(condition)) { \
+        fprintf(stderr, "NATIVE_PIPE_METADATA_FAIL line=%d errno=%d\n", __LINE__, errno); \
+        return 1; \
+    } \
+} while (0)
+
+int main(void)
+{
+    int pipefd[2], other[2], copy, file;
+    struct stat reader, writer, duplicate, regular, before;
+    struct raw_metadata raw, write_raw, canary, saved;
+    char data[5];
+
+    CHECK(pipe(pipefd) == 0);
+    CHECK(fstat(pipefd[0], &reader) == 0 && S_ISFIFO(reader.st_mode));
+    CHECK(fstat(pipefd[1], &writer) == 0 && S_ISFIFO(writer.st_mode));
+    CHECK(reader.st_ino != 0 && reader.st_ino == writer.st_ino);
+    CHECK(reader.st_size == 0 && writer.st_size == 0);
+    CHECK(metadata(pipefd[0], &raw) == 0 && metadata(pipefd[1], &write_raw) == 0);
+    CHECK(raw.type == 5 && write_raw.type == 5 && raw.id == write_raw.id);
+    CHECK(raw.permissions == 1 && write_raw.permissions == 2);
+    CHECK(raw.created == 0 && raw.modified == 0 && raw.accessed == 0);
+    CHECK(raw.links == 0 && raw.reserved == 0);
+
+    copy = dup(pipefd[0]);
+    CHECK(copy >= 0 && fstat(copy, &duplicate) == 0);
+    CHECK(duplicate.st_ino == reader.st_ino && S_ISFIFO(duplicate.st_mode));
+    CHECK(pipe(other) == 0 && metadata(other[0], &raw) == 0);
+    CHECK(raw.id != reader.st_ino);
+    CHECK(close(other[0]) == 0 && close(other[1]) == 0);
+
+    CHECK(write(pipefd[1], "hello", 5) == 5);
+    CHECK(fstat(pipefd[0], &reader) == 0 && reader.st_size == 5);
+    CHECK(fstat(pipefd[1], &writer) == 0 && writer.st_size == 5);
+    CHECK(read(copy, data, 5) == 5 && memcmp(data, "hello", 5) == 0);
+    CHECK(fstat(copy, &duplicate) == 0 && duplicate.st_size == 0);
+    CHECK(close(pipefd[1]) == 0);
+    CHECK(fstat(copy, &duplicate) == 0 && S_ISFIFO(duplicate.st_mode));
+    CHECK(read(copy, data, sizeof(data)) == 0);
+
+    memset(&canary, 0xa5, sizeof(canary));
+    saved = canary;
+    CHECK(metadata(UINTPTR_MAX, &canary) == UINTPTR_MAX);
+    CHECK(memcmp(&canary, &saved, sizeof(canary)) == 0);
+    /* Reject a high-word alias of an otherwise valid handle, without truncation. */
+    CHECK(metadata((uintptr_t)copy | ((uintptr_t)1 << 32), &canary) == UINTPTR_MAX);
+    CHECK(memcmp(&canary, &saved, sizeof(canary)) == 0);
+    CHECK(metadata(copy, NULL) == UINTPTR_MAX);
+    CHECK(close(pipefd[0]) == 0);
+    CHECK(metadata(pipefd[0], &canary) == UINTPTR_MAX);
+    CHECK(memcmp(&canary, &saved, sizeof(canary)) == 0);
+    /* SDK rejects negative POSIX descriptors as EBADF before the legacy syscall. */
+    memset(&reader, 0xa5, sizeof(reader));
+    before = reader;
+    errno = 0;
+    CHECK(fstat(-1, &reader) == -1 && errno == EBADF);
+    CHECK(memcmp(&reader, &before, sizeof(reader)) == 0);
+    CHECK(close(copy) == 0);
+
+    file = open("/tmp/pipe-metadata-regular", O_CREAT | O_TRUNC | O_RDWR, 0600);
+    CHECK(file >= 0 && write(file, "regular", 7) == 7);
+    CHECK(fstat(file, &regular) == 0 && S_ISREG(regular.st_mode) && regular.st_size == 7);
+    CHECK(metadata(file, &raw) == 0 && raw.type == 0 && raw.size == 7 && raw.id == regular.st_ino);
+    CHECK(close(file) == 0 && unlink("/tmp/pipe-metadata-regular") == 0);
+    puts("NATIVE_PIPE_METADATA_OK");
+    return 0;
+}
